# Optional Qwen LLM configuration (server-side only).
#
# 1. Copy this file to .env.local.
# 2. Paste your real API key after the equals sign below.
# 3. Never use a NEXT_PUBLIC_ prefix for this key and never commit .env.local.

# REQUIRED TO ENABLE QWEN — paste your key here:
DASHSCOPE_API_KEY=sk-eeaad51becf34580848a49ca632707b6

# Optional: copy the OpenAI-compatible base URL for your Model Studio/QwenCloud
# region from its console. The code defaults to the international endpoint below.
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Optional: choose a model available in your account. qwen3.7-flash is the default.
QWEN_MODEL=qwen3.7-flash

# With DASHSCOPE_API_KEY left empty, Mini Atoms uses its free local Agent fallback.
